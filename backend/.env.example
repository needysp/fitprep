# Google OAuth 2.0 client (see README for setup steps)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Any long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SESSION_SECRET=change-me

# Where the OAuth callback redirects after login (prod: your public origin)
FRONTEND_URL=http://localhost:5173

# Comma-separated bootstrap admins: always allowed to sign in and always granted
# the admin role. Set this to your own email so you can get in and manage the
# allowlist. Everyone else must be added to the allowlist by an admin.
ADMIN_EMAILS=you@example.com

# Optional overrides
# DATABASE_URL=sqlite:///./app.db
# SECURE_COOKIES=false   # set true in prod behind HTTPS
